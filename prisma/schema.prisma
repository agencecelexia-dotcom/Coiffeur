generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SalonInfo {
  id          String @id @default("singleton")
  name        String @default("Salon Élégance")
  address     String @default("")
  city        String @default("")
  postalCode  String @default("")
  phone       String @default("")
  email       String @default("")
  openingTime String @default("09:00") // HH:mm
  closingTime String @default("19:00") // HH:mm
  closedDays  String @default("0")     // comma-separated day numbers (0=Sunday)
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String
  order    Int       @default(0)
  services Service[]
}

model Service {
  id           String           @id @default(uuid())
  name         String
  description  String           @default("")
  duration     Int              // in minutes
  price        Float
  categoryId   String
  category     ServiceCategory  @relation(fields: [categoryId], references: [id])
  active       Boolean          @default(true)
  appointments Appointment[]
}

model StaffMember {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  bio          String        @default("")
  specialties  String        @default("") // comma-separated
  photoUrl     String        @default("")
  active       Boolean       @default(true)
  appointments Appointment[]
  schedules    StaffSchedule[]
}

model StaffSchedule {
  id        String      @id @default(uuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id])
  dayOfWeek Int         // 0=Sunday, 1=Monday, ...
  startTime String      // HH:mm
  endTime   String      // HH:mm
  isOff     Boolean     @default(false)

  @@unique([staffId, dayOfWeek])
}

model Client {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String        @unique
  phone        String        @default("")
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id        String      @id @default(uuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id])
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id])
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id])
  dateTime  DateTime
  duration  Int         // in minutes
  status    String      @default("confirmed") // confirmed, cancelled, completed, no_show
  notes     String      @default("")
  createdAt DateTime    @default(now())
}
